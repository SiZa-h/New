#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Source and data files: normalise to lf so diffs stay readable across platforms
*.java          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.gradle        text eol=lf
*.properties    text eol=lf
*.yml           text eol=lf
*.js            text eol=lf

# Generated art must be treated as binary: never let git rewrite line endings inside a PNG
*.png           binary

